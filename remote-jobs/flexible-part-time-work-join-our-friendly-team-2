.job-detail-title{font-size:1.6rem;margin-bottom:.6rem;letter-spacing:-.01em}
.job-detail-meta{display:flex;gap:.6rem;margin-bottom:1.4rem;flex-wrap:wrap}
.job-detail-meta span{font-family:'Fira Code',monospace;font-size:.7rem;text-transform:uppercase;letter-spacing:.02em;color:var(--ink-2);background:var(--surface-alt);padding:.25rem .65rem;border-radius:var(--radius-sm)}
