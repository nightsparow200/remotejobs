*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:'Karla',-apple-system,BlinkMacSystemFont,sans-serif;background:var(--bg);color:var(--ink);line-height:1.55;-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
.container{max-width:1100px;margin:0 auto;padding:0 1.5rem;width:100%}
h1,h2,h3,h4{font-family:'Manrope',sans-serif;font-weight:800;line-height:1.2;color:var(--ink)}

.detail-nav{background:var(--surface);border-bottom:1px solid var(--border)}
.detail-nav-inner{display:flex;flex-direction:column;align-items:stretch;padding:1rem 1.5rem;gap:.85rem}
.brand{display:inline-flex;align-items:center;gap:.55rem;font-family:'Manrope',sans-serif;font-weight:800;font-size:1.15rem;color:var(--ink)}
.brand-mark{width:16px;height:16px;background:var(--brand);clip-path:polygon(50% 0%,100% 25%,100% 75%,50% 100%,0% 75%,0% 25%);flex-shrink:0}
.detail-search{display:flex;max-width:320px;width:100%;border-radius:var(--radius-sm);overflow:hidden;box-shadow:var(--shadow-sm)}
.detail-search input{flex:1;border:0;padding:.5rem 1rem;font:inherit;font-size:1rem;background:var(--surface);color:var(--ink)}
.detail-search input:focus{outline:none}
.detail-search button{border:0;background:var(--accent);color:#fff;padding:0 .9rem;cursor:pointer;font-weight:700}

.breadcrumb-bar{background:var(--surface-alt);border-bottom:1px solid var(--border)}
.breadcrumb{padding:.6rem 1.5rem}
.breadcrumb ol{list-style:none;display:flex;align-items:center;gap:.3rem;font-size:.82rem;color:var(--muted);flex-wrap:wrap}
.breadcrumb li{display:flex;align-items:center;gap:.3rem}
.breadcrumb a{color:var(--muted)}
.breadcrumb a:hover{color:var(--brand-dark)}
.breadcrumb li[aria-current="page"]{color:var(--ink-2)}

.job-detail-page{padding:1.75rem 1.5rem 2.5rem;max-width:880px}
.back-link{display:inline-flex;align-items:center;gap:.3rem;margin-bottom:1.25rem;font-size:.88rem;font-weight:700;color:var(--ink-2)}
.back-link:hover{color:var(--brand-dark)}
.job-detail{background:var(--surface);border-radius:var(--radius);box-shadow:var(--shadow-sm);padding:1.75rem}
