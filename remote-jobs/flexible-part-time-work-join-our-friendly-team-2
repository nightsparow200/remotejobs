.job-detail-body h3{font-size:1rem;margin:1.2rem 0 .5rem}
.job-detail-body ul,.job-detail-body ol{margin:0 0 1rem 1.2rem}
.job-detail-body li{margin-bottom:.4rem}
.job-detail-body strong{color:var(--ink)}
.job-detail-body a{color:var(--brand-dark);text-decoration:underline}
.job-detail-actions{display:flex;align-items:center;gap:1.2rem;margin-top:1.6rem;padding-top:1.4rem;border-top:1px solid var(--border);flex-wrap:wrap}
.apply-btn{display:inline-flex;align-items:center;gap:.5rem;background:var(--accent);color:#fff;font-weight:700;font-size:.92rem;padding:.75rem 1.5rem;border-radius:var(--radius-sm);box-shadow:var(--shadow-sm);transition:background .15s,transform .1s}
.apply-btn:hover{background:var(--accent-dark)}
.apply-btn:active{transform:scale(.98)}
.detail-permalink{font-size:.85rem;color:var(--muted);font-weight:700}
.detail-permalink:hover{color:var(--brand-dark)}

.similar-jobs{margin-top:2.5rem}
.similar-jobs-title{font-size:1.2rem;margin-bottom:1rem}
.jobs-grid{display:grid;grid-template-columns:1fr;gap:1rem}
.job-card{background:var(--surface);border-radius:var(--radius);padding:1.1rem 1.2rem;transition:all .15s;box-shadow:var(--shadow-sm);display:block}
.job-card:hover{box-shadow:var(--shadow);transform:translateY(-2px)}
.job-card .job-title{font-size:.95rem;font-weight:700;color:var(--ink);margin-bottom:.5rem;font-family:'Karla',sans-serif;line-height:1.35}
.job-card .job-meta{display:flex;gap:.5rem;flex-wrap:wrap}
.job-card .job-meta span{font-family:'Fira Code',monospace;font-size:.66rem;text-transform:uppercase;letter-spacing:.02em;color:var(--muted);background:var(--surface-alt);padding:.15rem .5rem;border-radius:var(--radius-sm)}

.ad-wrap{text-align:center;width:100%;padding:14px 0;overflow:hidden;display:flex;justify-content:center;align-items:center}

.mobile-apply{display:none;position:fixed;bottom:0;left:0;right:0;padding:10px;background:var(--surface);border-top:1px solid var(--border);z-index:100}
.mobile-apply a{display:block;text-align:center;padding:13px;background:var(--accent);color:#fff;font-weight:700;border-radius:var(--radius-sm)}

.site-footer{background:var(--ink);color:rgba(255,255,255,.7);margin-top:2rem}
.footer-grid{display:grid;grid-template-columns:1fr;gap:1.5rem;padding:2.5rem 1.5rem 1.5rem}
.footer-brand .brand{color:#fff;margin-bottom:.6rem}
.footer-brand p{color:rgba(255,255,255,.55);font-size:.88rem}
.footer-col h4{color:#fff;font-size:.85rem;text-transform:uppercase;letter-spacing:.04em;margin-bottom:.75rem;font-family:'Manrope',sans-serif}
.footer-col ul{list-style:none;display:flex;flex-direction:column;gap:.5rem}
.footer-col a{font-size:.88rem;color:rgba(255,255,255,.6)}
.footer-col a:hover{color:#fff}
.footer-meta{display:flex;flex-direction:column;gap:.4rem;font-size:.85rem;color:rgba(255,255,255,.5)}
.footer-bottom{display:flex;flex-direction:column;gap:.5rem;padding:1.25rem 1.5rem;border-top:1px solid rgba(255,255,255,.1);font-size:.8rem;color:rgba(255,255,255,.45)}

@media (min-width:560px){
  .detail-nav-inner{flex-direction:row;align-items:center;justify-content:space-between}
  .jobs-grid{grid-template-columns:repeat(2,1fr)}
